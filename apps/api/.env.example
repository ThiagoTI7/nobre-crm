# Conexão com o PostgreSQL (nunca commitar o .env real)
DATABASE_URL=postgres://nobre:nobre@localhost:5432/nobre_crm

# Porta e origens permitidas (CORS), separadas por vírgula
PORT=3333
CORS_ORIGINS=http://localhost:3000

# Data de referência do case (15/10/2026). Remova/deixe vazio para usar a data real.
REFERENCE_DATE=2026-10-15

# Opcional: webhook (ex.: Slack/Teams) para `npm run digest -- --send`
DIGEST_WEBHOOK_URL=

# Apenas para os testes de integração (o banco é recriado!)
TEST_DATABASE_URL=postgres://nobre:nobre@localhost:5432/nobre_crm_test

# Em produção atrás de proxy (Render): TRUST_PROXY=true
TRUST_PROXY=false
